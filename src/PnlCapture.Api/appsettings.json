{
  "ConnectionStrings": {
    "PnlDatabase": "Data Source=data/pnlcapture.db;Default Timeout=5;Cache=Shared"
  },
  "RabbitMq": {
    "ExchangeName": "pnl.exchange",
    "QueueName": "pnl.records",
    "RetryQueueName": "pnl.retry",
    "DeadLetterQueueName": "pnl.dead",
    "RetryDelayMilliseconds": 5000,
    "MaxRetryCount": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
